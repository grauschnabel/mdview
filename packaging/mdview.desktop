[Desktop Entry]
Type=Application
Name=mdview
GenericName=Markdown Viewer
Comment=Read Markdown files with automatic live reload
Comment[de]=Markdown-Dateien lesen, mit automatischem Neuladen
Exec=mdview %f
Icon=mdview
Terminal=false
Categories=Office;Viewer;TextTools;
Keywords=markdown;md;preview;reader;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
